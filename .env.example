# 运行环境：development / production
# production 下 JWT_SECRET 缺失、为空、为占位值或长度不足 32 时，应用拒绝启动
ENV=development

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 数据库（SQLite 本地 / MySQL 生产）
SQLITE_PATH=sqlite+aiosqlite:///./travel.db

# JWT：至少 32 位随机串，留空时开发环境会用随机临时密钥并给出 warning
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# Agent
MAX_TOOL_ITERATIONS=3

# 前端高德地图（复制到 frontend/.env.local）
VITE_AMAP_KEY=
VITE_AMAP_SECURITY_CODE=

# 可选：LangSmith 追踪
# LANGSMITH_API_KEY=lsv2_pt_...
# LANGSMITH_PROJECT=travel_planning_agent
